# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/practicefront

# ── Auth (better-auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3000

# ── App URL (for auth client + email links) ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe (partner billing) ──────────────────────────────────────────────────
# Secret key from Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret from Stripe dashboard → Webhooks → endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Price ID for the per-practice subscription ($25/mo, quantity = # practices)
# Create in Stripe dashboard → Products → "Partner — per practice" → Recurring
STRIPE_PARTNER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cron authentication — any random secret; set in Vercel project env vars too
CRON_SECRET=your-cron-secret-here

# ── Sanity CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token
